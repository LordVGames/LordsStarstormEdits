    "SS2_KNIGHT_DESCRIPTION": "The Knight is a skilled expert in melee combat, dueling and parrying foes with precise timing and execution.\n\n<color=#CCD3E0>< ! > FULLY WORKS ONLY WHEN PLAYED BY THE HOST\n< ! > parry.",

    "SS2_KNIGHT_PASSIVE_DESC": "A buff ward surronds you that grants allies in its radius <style=cIsDamage>20% attack speed</style> and <style=cIsDamage>20% damage</style>.",

    "SS2_KEYWORD_PARRY": "<style=cKeywordName>Parry</style><style=cSub>Block an incoming hit to <style=cIsUtility>stun</style> and deal <style=cIsDamage>350% damage</style> to all enemies around you. You also become <style=cIsUtility>immune to damage</style> for 1 second.</style>",
    "SS2_KEYWORD_EMPOWERING": "<style=cKeywordName>Empowering</style><style=cSub><color=#fa78f3>Improves</color> your next skill use.</style>",

    "SS2_KNIGHT_PRIMARY_SWORD_DESC": "Slice forward for <style=cIsDamage>200% damage</style>. Every third hit stabs forward for <style=cIsDamage>400% damage</style>. While blocking, bash enemies for <style=cIsDamage>240% damage</style>.",
    "SS2_KNGIHT_PRIMARY_SWORD_UPRGADE_TOOLTIP": "<style=cKeywordName><color=#fa78f3>Empowered</color></style><style=cSub>Dash forward, and strike for <style=cIsDamage>3x400% damage</style>.</style>",

    "SS2_KNIGHT_SECONDARY_SHIELD_DESC": "Raise your shield, gaining <style=cIsUtility>400 armor</style>. Use before an incoming strike to <style=cIsDamage>parry</style> it and <color=#fa78f3>Empower</color> your next skill.",
    "SS2_KNIGHT_SECONDARY_SHIELD_DESC2": "Raise your shield, gaining <style=cIsUtility>400 armor</style> and replacing your jump with a <style=cIsUtility>roll</style>. Use before an incoming strike to <style=cIsDamage>parry</style> it and <color=#fa78f3>Empower</color> your next skill.",

    "SS2_KNIGHT_SHIELD_BASH_DESC": "Shield Bash in front of you for <style=cIsDamage>240% damage</style> and <style=cIsUtility>stun</style> enemies hit.",

    "SS2_KNIGHT_UTILITY_LEAP_DESC": "Dash foward, spinning and slicing repeatedly for <style=cIsDamage>120% damage</style> per hit. The number of hits scales with attack speed.",
    "SS2_KNIGHT_UTILITY_LEAP_UPGRADE_TOOLTIP": "<style=cKeywordName><color=#fa78f3>Empowered</color></style><style=cSub>Travel further, dealing <style=cIsDamage>200% damage</style> per hit.</style>",

    "SS2_KNIGHT_SPECIAL_BANNER_DESC": "Thrust a banner into the ground for <style=cIsDamage>300% damage</style>. It grants <style=cIsHealing>7.5% health regeneration</style>, <style=cIsUtility>2.7% movement speed</style>, <style=cIsUtility>30% jump height</style>, and <style=cIsDamage>41.6% damage</style> to nearby allies while <style=cIsUtility>slowing</style> nearby enemies' movement speed by <style=cIsUtility>44.5%</style>.",
    "SS2_KNIGHT_SPECIAL_BANNER_UPGRADE_TOOLTIP": "<style=cKeywordName><color=#fa78f3>Empowered</color></style><style=cSub>CURRENTLY DOES NOT WORK. Additionally grants <style=cIsUtility>40% barrier</style>.</style>",

